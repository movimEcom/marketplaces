# Credenciales de la app creada en https://developers.mercadolibre.com.mx/
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# Debe coincidir EXACTAMENTE con la "Redirect URI" configurada en la app.
# Para el login local con `meli-mx-authorize` usa un puerto libre de tu máquina.
MELI_REDIRECT_URI=http://localhost:8765/callback

# Sitio de Mercado Libre: MLM = México
MELI_SITE_ID=MLM

# Dónde se guardan los tokens (access/refresh) tras autenticarte. No se sube a git.
MELI_TOKEN_PATH=~/.config/marketplaces-mcp/meli_tokens.json

# --- Alpha ERP (solo lectura) ---
# Carpeta donde Alpha guarda sus .DBF. Ruta local del servidor (C:\Alpha\Datos)
# o carpeta compartida (\\SERVIDOR\Alpha\Datos, o /mnt/alpha en Linux/Mac).
ALPHA_DATA_DIR=
# Vacío = se detecta del encabezado de cada DBF. Si salen acentos/ñ raros prueba cp850 o cp1252.
ALPHA_DBF_ENCODING=
# Máximo de filas por consulta
ALPHA_MAX_ROWS=500
# Niveles de subcarpetas donde buscar .DBF (0 = solo ALPHA_DATA_DIR). Súbelo si faltan tablas.
ALPHA_SCAN_DEPTH=1
